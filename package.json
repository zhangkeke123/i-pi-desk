{
  "name": "i-pi-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI coding agent desktop client",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @i-pi-desk/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:desktop": "pnpm --filter @i-pi-desk/desktop build",
    "typecheck": "pnpm run build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "verify": "pnpm typecheck && pnpm test && pnpm verify:protocol && pnpm verify:plugins && pnpm verify:history && pnpm verify:approval-timeout && pnpm verify:anthropic-history && pnpm verify:api-matrix && pnpm verify:anthropic-tool-loop && pnpm verify:allow-always && pnpm verify:deny-feedback && pnpm verify:tools-download && pnpm verify:no-persistence && pnpm verify:diff-preview && pnpm verify:project-trust && pnpm verify:thinking-level && pnpm verify:max-steps && pnpm verify:doc-claims && pnpm verify:danger-gate && pnpm verify:approval-policy && pnpm verify:plugin-failure && pnpm verify:plugin-orphan && pnpm verify:contract && pnpm verify:kernel-deps && pnpm --filter @i-pi-desk/desktop run verify:renderer && pnpm verify:bundle",
    "verify:contract": "node tools/mock-control-plane/verify-contract.mjs",
    "verify:protocol": "pnpm --filter @i-pi-desk/agent-host run verify:protocol",
    "verify:plugins": "pnpm --filter @i-pi-desk/agent-host run verify:plugins",
    "verify:history": "pnpm --filter @i-pi-desk/agent-host run verify:history",
    "verify:packaged": "pnpm --filter @i-pi-desk/desktop run verify:packaged",
    "verify:bundle": "pnpm --filter @i-pi-desk/desktop run verify:bundle",
    "verify:renderer": "pnpm --filter @i-pi-desk/desktop run verify:renderer",
    "rebuild:pty": "pnpm --filter @i-pi-desk/desktop run rebuild:pty",
    "control-plane:mock": "node tools/mock-control-plane/server.mjs --port 8099",
    "pack": "pnpm --filter @i-pi-desk/desktop run pack",
    "dist": "pnpm --filter @i-pi-desk/desktop run dist",
    "build:packages": "pnpm --filter @i-pi-desk/shared --filter @i-pi-desk/agent-host run build",
    "verify:approval-timeout": "pnpm --filter @i-pi-desk/agent-host run verify:approval-timeout",
    "verify:anthropic-history": "pnpm --filter @i-pi-desk/agent-host run verify:anthropic-history",
    "verify:api-matrix": "pnpm --filter @i-pi-desk/agent-host run verify:api-matrix",
    "verify:anthropic-tool-loop": "pnpm --filter @i-pi-desk/agent-host run verify:anthropic-tool-loop",
    "verify:allow-always": "pnpm --filter @i-pi-desk/agent-host run verify:allow-always",
    "verify:deny-feedback": "pnpm --filter @i-pi-desk/agent-host run verify:deny-feedback",
    "verify:tools-download": "pnpm --filter @i-pi-desk/agent-host run verify:tools-download",
    "verify:no-persistence": "pnpm --filter @i-pi-desk/agent-host run verify:no-persistence",
    "verify:diff-preview": "pnpm --filter @i-pi-desk/agent-host run verify:diff-preview",
    "verify:project-trust": "pnpm --filter @i-pi-desk/agent-host run verify:project-trust",
    "verify:danger-gate": "pnpm --filter @i-pi-desk/agent-host run verify:danger-gate",
    "verify:approval-policy": "pnpm --filter @i-pi-desk/agent-host run verify:approval-policy",
    "verify:plugin-failure": "pnpm --filter @i-pi-desk/agent-host run verify:plugin-failure",
    "verify:plugin-orphan": "pnpm --filter @i-pi-desk/agent-host run verify:plugin-orphan",
    "verify:doc-claims": "pnpm --filter @i-pi-desk/agent-host run verify:doc-claims",
    "verify:kernel-deps": "node tools/verify-kernel-deps.mjs",
    "verify:thinking-level": "pnpm --filter @i-pi-desk/agent-host run verify:thinking-level",
    "verify:max-steps": "pnpm --filter @i-pi-desk/agent-host run verify:max-steps"
  }
}
