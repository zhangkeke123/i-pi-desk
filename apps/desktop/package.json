{
  "name": "@i-pi-desk/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "i-pi-desk desktop application",
  "author": "i-pi-desk",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:deps": "pnpm --filter @i-pi-desk/shared --filter @i-pi-desk/agent-host run build",
    "dev": "pnpm run ensure:electron && pnpm run build:deps && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types scripts/verify-provider-key.ts && node --experimental-strip-types scripts/verify-window-state.ts && node --experimental-strip-types scripts/verify-diff-parse.ts && node --experimental-strip-types scripts/verify-workspace-fs.ts && node --experimental-strip-types scripts/verify-skills.ts && node --experimental-strip-types scripts/verify-pty-failure.ts && node --experimental-strip-types scripts/verify-close-guard.ts && node --experimental-strip-types scripts/verify-session-scope.ts && node --experimental-strip-types scripts/verify-workspace-list.ts && node --experimental-strip-types scripts/verify-ui-logic.ts && node --experimental-strip-types scripts/verify-workspace-facts.ts && node --experimental-strip-types scripts/verify-update-policy.ts",
    "verify:renderer": "pnpm run ensure:electron && pnpm run build:deps && pnpm run build && node scripts/verify-renderer.mjs",
    "verify:packaged": "pnpm run ensure:electron && node scripts/verify-packaged.mjs",
    "verify:bundle": "pnpm run build:deps && pnpm run build && node scripts/verify-bundle.mjs",
    "rebuild:pty": "node scripts/rebuild-pty.mjs",
    "bundle:runtime": "pnpm --filter @i-pi-desk/agent-host run bundle",
    "pack": "pnpm run build:deps && pnpm run bundle:runtime && electron-vite build && electron-builder --dir",
    "dist": "pnpm run build:deps && pnpm run bundle:runtime && electron-vite build && electron-builder",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@i-pi-desk/agent-host": "workspace:*",
    "@i-pi-desk/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "remark-cjk-friendly": "^2.3.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "ws": "^8.21.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "net.ipidesk.app",
    "productName": "i-pi-desk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../packages/agent-host/dist-bundle",
        "to": "agent-host"
      },
      {
        "from": "../../THIRD-PARTY.md",
        "to": "THIRD-PARTY.md"
      },
      {
        "from": "resources/install-defaults.json",
        "to": "install-defaults.json"
      },
      {
        "from": "resources/update-feed.json",
        "to": "update-feed.json"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "i-pi-desk",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "zhangkeke123",
      "repo": "i-pi-desk"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "linux": {
      "category": "Development",
      "executableName": "i-pi-desk",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
